#!/bin/sh
# Claude Code host 세션을 시작한다. 이 세션에만 다른 로컬 세션 메시지 자동 수신
# (crossSessionInbound=accept)을 적용해 worker 완료 알림이 native inbox로 들어오게 한다.
# 전역·프로젝트 settings 파일과 도구 승인 설정은 바꾸지 않는다. 다른 claude 인자는 그대로 전달한다.
# 주의: 이 세션은 worker뿐 아니라 이 컴퓨터의 다른 로컬 Claude 세션 메시지도 자동으로 받는다.
# managed settings가 수신을 막으면 그 설정이 우선한다.
exec claude --settings '{"crossSessionInbound":"accept"}' "$@"
