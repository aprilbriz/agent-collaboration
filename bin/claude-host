#!/usr/bin/env python3
"""Claude host launcher; --check-host only reports argv detection and a restart command."""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path


def host_status(args):
    """ps drops argument quoting; accept only Claude plus an inline settings object."""
    try:
        words = shlex.split(args)
    except ValueError:
        return "unknown"
    if not words:
        return "unknown"
    executable = Path(words[0]).name
    is_claude = executable == "claude" or (
        executable in {"node", "nodejs", "bun"} and len(words) > 1
        and "claude-code" in words[1] and Path(words[1]).name in {"cli.js", "cli.mjs"}
    )
    if not is_claude:
        return "unknown"
    settings = []
    for i, word in enumerate(words):
        if word == "--settings":
            settings.append(" ".join(words[i + 1:]))
        elif word.startswith("--settings="):
            settings.append(word[len("--settings="):])
    if not settings:
        return "not_detected"
    value = settings[-1].lstrip()
    if not value.startswith("{") or "}" not in value:
        return "unknown"  # Do not infer the contents of settings files.
    inline = value[:value.index("}") + 1]
    if inline.count("{") != 1:
        return "unknown"
    match = re.search(r'''(?:^|[{,])\s*["']?crossSessionInbound["']?\s*:\s*["']?([A-Za-z]+)["']?\s*[,}]''', inline)
    if not match:
        return "not_detected"
    return "accept_arg_detected" if match.group(1) == "accept" else "not_detected"


def restart_command(workspace, plugin_dir, session_id=""):
    launcher = str(Path(__file__).resolve())
    command = [launcher, "--resume", session_id] if session_id else [launcher, "--continue"]
    if plugin_dir:
        command.extend(["--plugin-dir", plugin_dir])
    return f"cd {shlex.quote(workspace)} && {shlex.join(command)}"


def main():
    if sys.argv[1:2] == ["--check-host"]:
        parser = argparse.ArgumentParser(description="Report host argv detection; never restart.")
        parser.add_argument("--check-host", type=int, required=True, metavar="CLAUDE_PID")
        parser.add_argument("--workspace", required=True)
        args = parser.parse_args()
        if args.check_host <= 0 or not Path(args.workspace).is_absolute() or not Path(args.workspace).is_dir():
            parser.error("positive Claude PID and an existing absolute workspace are required")
        process = subprocess.run(["ps", "-o", "args=", "-p", str(args.check_host)],
                                 capture_output=True, text=True)
        status = host_status(process.stdout.strip()) if process.returncode == 0 else "unknown"
        session_id = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        warnings = ["기존 세션을 먼저 /exit로 종료한 뒤 restart_command를 셸에 붙여 넣으세요."]
        if not session_id:
            warnings.append("CLAUDE_CODE_SESSION_ID가 없어 --continue를 사용합니다. "
                            "workspace의 가장 최근 대화를 열므로 원래 cwd나 최근 대화가 다르면 "
                            "다른 대화가 열리거나 대화를 찾지 못할 수 있습니다.")
        print(json.dumps({"status": status,
                          "restart_command": restart_command(args.workspace,
                              os.environ.get("ORCA_CLAUDE_AGENT_VIEW_PLUGIN_DIR", ""), session_id),
                          "warnings": warnings},
                         ensure_ascii=False))
        return
    # Preserve normal launcher pass-through; managed settings still take precedence.
    os.execvp("claude", ["claude", "--settings", '{"crossSessionInbound":"accept"}', *sys.argv[1:]])


if __name__ == "__main__":
    main()
